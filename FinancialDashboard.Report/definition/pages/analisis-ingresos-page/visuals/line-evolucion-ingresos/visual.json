                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "70L"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
